void loop() {
  battery();

  if (tensaobatt >= 4.10 && dev == 0) {
    display.clearDisplay();
    display.setTextColor(1);
    display.setTextWrap(false);
    display.setCursor(35, 10);
    display.print("CARREGANDO");

    // battery_charger_connected
    display.drawBitmap(40, 26, image_battery_charger_connected_bits, 48, 32, 1);

    display.display();
  } else {




    veriqBLE();
    float tempC = sensor.readTempC();
    float ax = sensor.readFloatAccelX() - axfix;  // pega o valor ax e subtrai pelo valor corrigido
    float ay = sensor.readFloatAccelY() - ayfix;  // pega o valor ay e subtrai pelo valor corrigido
    float az = sensor.readFloatAccelZ() - azfix;  // pega o valor az e subtrai pelo valor corrigido
    float gx = sensor.readFloatGyroX() - gxfix;   // pega o valor gx e subtrai pelo valor corrigido
    float gy = sensor.readFloatGyroY() - gyfix;   // pega o valor gy e subtrai pelo valor corrigido
    float gz = sensor.readFloatGyroZ() - gzfix;   // pega o valor gz e subtrai pelo valor corrigido

    // suavização dos valores (valores antigos, novos valores)
    ax = smooth(axOld, ax);
    ay = smooth(ayOld, ay);
    az = smooth(azOld, az);
    gx = smooth(gxOld, gx);
    gy = smooth(gyOld, gy);
    gz = smooth(gzOld, gz);

    // Atualiza o índice 'i' de 0 a 2 de forma cíclica (0 → 1 → 2 → 0 → 1 → 2 ...)
    // Usado para armazenar os 7 valores mais recentes na suavização !!!!! alterar aq tambem se mudar a quantidade de amostras na media !!!!!!
    i = (i + 1) % 7;

    //----------------------------------pesquisar sobre o filtro kalman utizando giroscopio + acelerometro----------------------------------

    float rollAcc = atan2(ay, sqrt(ax * ax + az * az)) * 180.0 / PI;
    float pitchAcc = atan2(-ax, sqrt(ay * ay + az * az)) * 180.0 / PI;

    // --- filtro complementar simples ---
    static float roll = 0;
    static float pitch = 0;

    unsigned long now = millis();
    float dt = (now - lastTime) / 1000.0;
    if (dt <= 0 || dt > 0.1) dt = 0.01;  // segurança contra valores ruins
    lastTime = now;

    // peso entre giroscópio e acelerômetro (ajusta esse valor)
    const float alpha = 0.75;

    roll = alpha * (roll + gx * dt) + (1 - alpha) * rollAcc;
    pitch = alpha * (pitch + gy * dt) + (1 - alpha) * pitchAcc;



    roll2 = constrain((int)roll, -99, 99);
    pitch2 = constrain((int)pitch, -99, 99);

    // mostra os valores no serial monitor
    /* Serial.print("Acel X: ");
  Serial.print(ax);
  Serial.print(" Y: ");
  Serial.print(ay);
  Serial.print(" Z: ");
  Serial.println(az);
  Serial.print("Giro X: ");
  Serial.print(gx);
  Serial.print(" Y: ");
  Serial.print(gy);
  Serial.print(" Z: ");
  Serial.println(gz);
*/
    // imprime os valores de rotação e inclinação


    Serial.print("Rotação lateral: ");
    Serial.print(roll);  // rotação lateral (Roll)
    Serial.print("°  ");
    Serial.print("Inclinação: ");
    Serial.print(pitch);  // inclinação (Pitch)
    Serial.println("°");


    //Serial Plotter
    Serial.print(roll2);  // Rotação
    Serial.print("\t");
    Serial.print(pitch2);  // Inclinação
    Serial.println();
    // leitura(); // para ver os valores bruto

    BLE(ax, ay, az, gx, gy, gz);

    int percentagem_atual = battery();

    display.clearDisplay();

    // Layer 5
    display.drawBitmap(1, 43, image_Layer_5_bits, 128, 21, 1);

    // Layer 1
    display.setTextColor(1);
    display.setTextSize(2);
    display.setTextWrap(false);
    display.setCursor(4, 4);
    display.print("ROLL:");

    // Layer 2
    display.setCursor(4, 25);
    display.print("PITCH:");

    // Layer 3
    display.setCursor(75, 3);
    display.print(roll2);

    // Layer 4
    display.setCursor(75, 25);
    display.print(pitch2);

    // download
    display.drawBitmap(44, 46, image_download_bits, 24, 16, 0);

    // Layer 9
    display.setTextColor(0);
    display.setTextSize(1);
    display.setCursor(88, 50);
    display.print("%");
    display.setCursor(70, 50);
    display.print(percentagem_atual);

    // Layer 9
    display.drawBitmap(114, 0, image_Layer_9_bits, 14, 43, 1);
    display.display();
  }

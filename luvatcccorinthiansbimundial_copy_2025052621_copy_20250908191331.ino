// correção dos valores
float axfix = 0.00;  //--]
float ayfix = 0.00;  //  ]-acelerometro
float azfix = 0.00;  //--]
float gxfix = 0.00;  //--]
float gyfix = 0.00;  //  ]-giroscopio
float gzfix = 0.00;  //--]
//mexer aq se for modificar a media
//N d medias↓     ↓  ↓  ↓  ↓ (adicionar ou tirar zero)
float axOld[7] = { 0, 0, 0, 0, 0, 0, 0 };  // acelerometro x
float ayOld[7] = { 0, 0, 0, 0, 0, 0, 0 };  // acelerometro y
float azOld[7] = { 0, 0, 0, 0, 0, 0, 0 };  // acelerometro z
float gxOld[7] = { 0, 0, 0, 0, 0, 0, 0 };  // giroscopio x
float gyOld[7] = { 0, 0, 0, 0, 0, 0, 0 };  // giroscopio y
float gzOld[7] = { 0, 0, 0, 0, 0, 0, 0 };  // giroscopio z
int i = 0;

unsigned long lastTime = 0;  // para calcular o dt (filtro de kalman)

// suavização dos valores
float smooth(float old[], float novo) {
  old[i] = novo;                                                              // guarda o novo
  return (old[0] + old[1] + old[2] + old[3] + old[4] + old[5] + old[6]) / 7;  // média dos 7 valores
  //mexer aq para aumentar a media  ↑              ↑
}

void fixsensor() {
  delay(1000);
  Serial.println("MANTENHA O SENSOR PARADO");  // tempo de calibraçao 30seg mas por algum motimo pode passar disso
  // soma a quantidade de leituras para calibrar o sensor
  calibracaodisplay();
  float somaAX = 0, somaAY = 0, somaAZ = 0;
  float somaGX = 0, somaGY = 0, somaGZ = 0;
  for (int n = 0; n < 5000; n++)  // 5000 leituras
  {
    somaAX += sensor.readFloatAccelX();  // X
    somaAY += sensor.readFloatAccelY();  // Y
    somaAZ += sensor.readFloatAccelZ();  // Z
    somaGX += sensor.readFloatGyroX();   // X
    somaGY += sensor.readFloatGyroY();   // Y
    somaGZ += sensor.readFloatGyroZ();   // Z
    delay(2);
  }
  // caso queria alterar a quantidade de leituras mudar esses comandos Soma / quantidade de leituras
  axfix = somaAX / 5000;
  ayfix = somaAY / 5000;
  azfix = somaAZ / 5000 - 1;  // -1 para corrigir a gravidade
  gxfix = somaGX / 5000;
  gyfix = somaGY / 5000;
  gzfix = somaGZ / 5000;

  Serial.println("Pronto");
}

